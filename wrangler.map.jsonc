{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weather-map-tiles-worker",
  "main": "cloudflare-worker/map-tiles-worker.mjs",
  "compatibility_date": "2026-08-20",
  "r2_buckets": [
    {
      "binding": "MAP_TILES",
      "bucket_name": "weather-map-tiles"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
